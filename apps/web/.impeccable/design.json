  "narrative": {
    "northStar": "The Evidence Control Room",
    "overview": "Omarchy Agents inherits the visual world of an Omarchy system console: dark, quiet, tightly ruled, and built for sustained scrutiny. Terminal-adjacent typography, near-black tonal layers, persistent navigation and analyst edges, and small operational signals rather than decorative illustration.",
    "keyCharacteristics": [
      "Dark, low-chroma Omarchy console surfaces.",
      "Ruled data regions instead of floating dashboard cards.",
      "Monospaced headings, labels, metrics, timestamps, and evidence.",
      "Persistent navigation and analyst rails with responsive drawer and bottom-navigation.",
      "Restrained gold accent, semantic status dots, provider color for attribution only.",
      "Keyboard-visible focus, non-color status labels, reduced-motion behavior."
    ],
    "rules": [
      {
        "name": "The Gold Is Orientation Rule",
        "body": "Reserve gold for current-location emphasis and the trophy identity; do not spread it across charts, buttons, or surfaces.",
        "section": "colors"
      },
      {
        "name": "The Provider Ownership Rule",
        "body": "Provider hues belong to provider marks, chart segments, and share indicators; they never replace semantic status colors.",
        "section": "colors"
      },
      {
        "name": "The Labeled Signal Rule",
        "body": "Color may reinforce status, but the adjacent text must carry the meaning.",
        "section": "colors"
      },
      {
        "name": "The Instrument Type Rule",
        "body": "Use mono wherever the user compares, locates, or verifies; use sans-serif for explanation and conversation.",
        "section": "typography"
      },
      {
        "name": "The Ruled Field Rule",
        "body": "Prefer full-width sections, aligned columns, and one-pixel separators over isolated card mosaics.",
        "section": "layout"
      },
      {
        "name": "The Flat-by-Default Rule",
        "body": "Resting surfaces do not float; only the overlaid analyst drawer receives structural elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the desktop hierarchy of navigation, comparison canvas, and advisory analyst rail.",
      "Do keep text equivalents for status color and chart content.",
      "Do retain indexed and metrics-only as distinct coverage labels."
    ],
    "donts": [
      "Don't turn the interface into floating rounded cards or add decorative shadows.",
      "Don't use gold as a general brand wash or status color.",
      "Don't let provider colors imply success, warning, or error."
    ]
  }
}