# Non-secret runtime configuration. Copy only the values needed to
# ~/.config/omarchy-agents/dashboard.env and keep that file mode 0600.
CLOUDFLARE_ACCESS_TEAM=your-team-name
CLOUDFLARE_ACCESS_AUD=your-access-application-audience-tag
CLOUDFLARE_ACCESS_ADMIN_AUD=comma-separated-audiences-of-the-admin-access-apps
ACCESS_EMAIL=you@example.com
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b
PRODUCTIVITY_GITHUB_OWNER=your-public-github-owner
PRODUCTIVITY_GITHUB_OWNER_TYPE=user
# Optional comma-separated repository names or owner/name values.
PRODUCTIVITY_GITHUB_REPOS=
# Secret personal API key; the runtime environment file must remain mode 0600.
LINEAR_API_KEY=lin_api_replace_me
PRODUCTIVITY_LINEAR_TEAM_IDS=comma-separated-linear-team-uuids
PRODUCTIVITY_TIME_ZONE=America/Los_Angeles
