{
  "name": "omarchy-agents",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "API_ORIGIN": "https://agents-api.harlanljones.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/limits", "/limits/*"]
  }
}
